# ===========================================================================
# ZY Commerce — .gitignore
# Public repository: anything that could contain secrets or machine-specific
# state is excluded. If you need to commit an exception, add a negation rule
# below the section and explain why.
# ===========================================================================

# --- Secrets & environment ------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
.envrc
.direnv/
secrets/
*.secret
*.secrets
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
*.gpg
*.asc
.npmrc
.yarnrc
.yarnrc.yml
.pnpmrc
.netrc
.htpasswd
.aws/
.gcloud/
.azure/
.stripe/
.vercel/
.vercel
.turbo/
.contentlayer/

# --- Dependencies ------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

