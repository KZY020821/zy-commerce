{
  "name": "zy-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "up": "bash scripts/dev-up.sh",
    "down": "docker compose down",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "pnpm db:migrate:test && vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test:all",
    "vercel-build": "bash scripts/vercel-build.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@auth/core": "0.41.3",
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/oidc": "^3.8.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.13.2",
  "description": "Multi-tenant product catalog, storefront and order management platform.",
  "engines": {
    "node": ">=22"
  }
}
