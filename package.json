{
  "name": "zy-monorepo",
  "private": true,
  "packageManager": "pnpm@9.13.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm --filter catalog-concierge build && pnpm --filter zy-commerce build",
    "dev": "pnpm --filter zy-commerce dev",
    "up": "pnpm --filter zy-commerce up",
    "down": "pnpm --filter zy-commerce down",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter zy-commerce test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
