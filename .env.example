# ZY Commerce — environment variables
# Copy to `.env` for local development. Never commit real values.

# ---------------------------------------------------------------------------
# Core (required in every environment)
# ---------------------------------------------------------------------------
# Runtime (pooled) Postgres connection. Local default matches docker-compose.yml.
# Supabase: use the *Transaction pooler* URL (port 6543) and append ?pgbouncer=true
DATABASE_URL="postgresql://zy:zy@localhost:5432/zy_commerce?schema=public"
# Direct / session connection used ONLY by the Prisma CLI (migrate, seed, studio).
# Local: leave blank (falls back to DATABASE_URL). Supabase: the *Session pooler* URL (port 5432).
DIRECT_URL=""
# The Vercel ↔ Supabase integration injects POSTGRES_PRISMA_URL / POSTGRES_URL /
# POSTGRES_URL_NON_POOLING instead; those are read automatically when the two above are unset.
# Optional pg pool size per server instance (default 10, or 5 on Vercel).
DATABASE_POOL_MAX=""

# Auth.js secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Required because tenants are served from many subdomains.
AUTH_TRUST_HOST="true"

# Root domain used for subdomain tenant routing. {slug}.<ROOT_DOMAIN>
# Local: localhost:3000  (Chrome/Firefox resolve *.localhost automatically)
# Prod:  yourplatform.com, or <project>.vercel.app while you have no custom domain
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Optional exact-hostname aliases, "slug=host,slug=host". Needed on *.vercel.app
# (which cannot nest subdomains) and usable as per-tenant custom domains.
# Example: TENANT_HOST_ALIASES="demo=zy-commerce-demo.vercel.app"
TENANT_HOST_ALIASES=""

# ---------------------------------------------------------------------------
# Seed (used only by `pnpm db:seed`)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="owner@example.com"
# Leave blank to have the seed generate a random password and print it once.
SEED_SUPER_ADMIN_PASSWORD=""
# Create a "demo" tenant with a store-admin account for local development.
SEED_DEMO_TENANT="true"
SEED_DEMO_ADMIN_EMAIL="admin@demo.example.com"
SEED_DEMO_ADMIN_PASSWORD=""
SEED_DEMO_CURRENCY="USD"
SEED_DEMO_COUNTRY="US"
SEED_DEMO_LOCALE="en-US"
SEED_DEMO_STORE_NAME="Selkirk Demo"
SEED_DEMO_BRAND_COLOR="#111111"
SEED_DEMO_ASSISTANT_NAME="Selkirk Fit Assistant"
# Load the imported catalogue (prisma/seed-data/selkirk.json, see scripts/import-shopify-catalog.ts).
SEED_DEMO_CATALOG="true"

# ---------------------------------------------------------------------------
# Product assistant (storefront chatbot). One of these enables it:
#   ANTHROPIC_API_KEY  — Anthropic API key (console.anthropic.com)
#   AI_GATEWAY_API_KEY — Vercel AI Gateway key; on Vercel the deployment's
#                        VERCEL_OIDC_TOKEN is used automatically instead.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
AI_GATEWAY_API_KEY=""
# Model id (default claude-opus-5; prefixed with anthropic/ automatically on the gateway)
AI_MODEL=""

# ---------------------------------------------------------------------------
# Stripe (Phase 3 — leave blank until then)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Transactional email (Phase 4 — leave blank until then)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="ZY Commerce <orders@example.com>"

# ---------------------------------------------------------------------------
# File storage for product images (Phase 1 — leave blank until then)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
