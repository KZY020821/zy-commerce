# ZY Commerce — environment variables
# Copy to `.env` for local development. Never commit real values.

# ---------------------------------------------------------------------------
# Core (required in every environment)
# ---------------------------------------------------------------------------
# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://zy:zy@localhost:5432/zy_commerce?schema=public"

# Auth.js secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Required because tenants are served from many subdomains.
AUTH_TRUST_HOST="true"

# Root domain used for subdomain tenant routing. {slug}.<ROOT_DOMAIN>
# Local: localhost:3000  (Chrome/Firefox resolve *.localhost automatically)
# Prod:  yourplatform.com
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ---------------------------------------------------------------------------
# Seed (used only by `pnpm db:seed`)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="owner@example.com"
# Leave blank to have the seed generate a random password and print it once.
SEED_SUPER_ADMIN_PASSWORD=""
# Create a "demo" tenant with a store-admin account for local development.
SEED_DEMO_TENANT="true"
SEED_DEMO_ADMIN_EMAIL="admin@demo.example.com"
SEED_DEMO_ADMIN_PASSWORD=""
SEED_DEMO_CURRENCY="USD"
SEED_DEMO_COUNTRY="US"
SEED_DEMO_LOCALE="en-US"

# ---------------------------------------------------------------------------
# Stripe (Phase 3 — leave blank until then)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Transactional email (Phase 4 — leave blank until then)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="ZY Commerce <orders@example.com>"

# ---------------------------------------------------------------------------
# File storage for product images (Phase 1 — leave blank until then)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
